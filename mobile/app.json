{
  "expo": {
    "name": "Jev Interview Studio",
    "slug": "jev-interview-studio",
    "scheme": "jevinterview",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record your interview responses for transcription."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.jev.interviewstudio"
    },
    "plugins": [
      "expo-audio",
      "expo-secure-store",
      "expo-status-bar",
      "expo-asset"
    ]
  }
}
